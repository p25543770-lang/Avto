# Пример файла настроек. Скопируйте в .env или задайте переменные в системе.
# Все переменные читаются при старте приложения (префикс AVTO_).

# --- рабочие папки (относительно корня проекта) ---
AVTO_INPUT_DIR=input
AVTO_TEMP_DIR=temp
AVTO_OUTPUT_DIR=output

# --- локальный LLM (OpenAI-совместимый) ---
AVTO_LLM_BASE_URL=http://127.0.0.1:1234/v1
AVTO_LLM_MODEL=local-model
AVTO_LLM_API_KEY=
AVTO_LLM_TIMEOUT=240

# --- распознавание речи ---
AVTO_WHISPER_MODEL=medium
AVTO_WHISPER_DEVICE=auto
AVTO_WHISPER_COMPUTE_TYPE=auto
AVTO_WHISPER_LANGUAGE=ru

# --- кодирование ---
AVTO_VIDEO_ENCODER=auto
AVTO_NVENC_PRESET=p4
AVTO_NVENC_CQ=20
AVTO_AUDIO_BITRATE=192k

# --- монтаж ---
AVTO_SILENCE_MARGIN=0.2
AVTO_LOUDNORM_I=-14
AVTO_LOUDNORM_TP=-1.5
AVTO_LOUDNORM_LRA=11

# --- шортсы ---
AVTO_SHORT_COUNT=3
AVTO_SHORT_MIN_DURATION=30
AVTO_SHORT_MAX_DURATION=55

# --- пути к бинарникам (если ffmpeg не в PATH) ---
# AVTO_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# AVTO_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# --- диагностика: транскрипция без нейросети ---
# AVTO_TRANSCRIBE_BACKEND=stub
